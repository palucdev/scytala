{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scytala",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build:worker",
    "watch_dir": "src"
  }
}
