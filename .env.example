# ==============================================================================
# Scytala Environment Configuration Template
# Copy this file to .env.local for local development or configure in Cloudflare dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Database & Auth Configuration (Mandatory)
# ------------------------------------------------------------------------------
# Supabase project API URL (Local: http://127.0.0.1:54321 | Cloud: https://<project>.supabase.co)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase public anonymous API key (used for client-side queries)
SUPABASE_ANON_KEY=eyJhYmNkZWZ...

# Supabase service role key (Mandatory for server-side operations and RPC execution)
# Keep this secret! Never expose this key in client-side bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhYmNkZWZ...

# ------------------------------------------------------------------------------
# Cryptographic & Session Configuration (Mandatory)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret used for HMAC-SHA256 JWT session token signing.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-secure-random-secret-key-with-at-least-32-characters

# Exactly 64 hex characters (32 bytes) key for AES-256-GCM note encryption at rest.
# Generate with: openssl rand -hex 32
# (Do NOT use `openssl rand -base64 32` — its 44-char base64 output cannot be used as raw AES-256 key material.)
NOTE_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Deployment & Version Metadata (Optional)
# ------------------------------------------------------------------------------
# Identifier for deployment tracking (defaults to "development")
DEPLOY_ID=development

# Semantic application version (defaults to "0.1.5")
APP_VERSION=0.1.5

# Logging level filter: "debug" | "info" | "warn" | "error" | "fatal" (defaults to "info")
LOG_LEVEL=info

# Global Supabase request timeout in milliseconds (defaults to 8000)
SUPABASE_TIMEOUT_MS=8000

